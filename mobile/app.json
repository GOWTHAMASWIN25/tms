{
  "expo": {
    "name": "GoExpo",
    "slug": "goexpo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "goexpo",
    "ios": {
      "bundleIdentifier": "com.goexpo.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.goexpo.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
